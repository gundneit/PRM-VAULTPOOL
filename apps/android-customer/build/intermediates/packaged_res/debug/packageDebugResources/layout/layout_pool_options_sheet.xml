<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_glass_card">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/tv_pool_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pool Options"
        android:textColor="@color/navy"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_pool_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select an action for this facility"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_edit_info"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="start|center_vertical"
        android:text="Edit Pool Information"
        android:textColor="@color/text_primary"
        app:icon="@android:drawable/ic_menu_edit"
        app:iconTint="@color/blue_royal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_status"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="start|center_vertical"
        android:text="Toggle Availability Status"
        android:textColor="@color/text_primary"
        app:icon="@android:drawable/ic_menu_manage"
        app:iconTint="@color/warning" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_slot"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="start|center_vertical"
        android:text="Add New Time Slot"
        android:textColor="@color/text_primary"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/success" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Cancel"
        app:cornerRadius="12dp" />

</LinearLayout>
